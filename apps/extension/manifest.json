{
  "manifest_version": 3,
  "name": "LeeTrack",
  "version": "1.0.0",
  "description": "Track your LeetCode progress collaboratively",
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": ["https://leetcode.com/*", "https://leetcode.cn/*", "http://localhost:3000/*","http://127.0.0.1:3000/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"],
      "js": ["content/submission-tracker.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/network-interceptor.js", "assets/fonts/*.woff2"],
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LeeTrack"
  }
}
