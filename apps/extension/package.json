{
  "name": "@leetrack/extension",
  "version": "1.0.0",
  "type": "module",
  "description": "LeeTrack browser extension for tracking LeetCode submissions",
  "private": true,
  "scripts": {
    "dev": "webpack --config build/webpack.config.js --mode development --watch",
    "build": "webpack --config build/webpack.config.js --mode production",
    "build:clean": "rm -rf dist && webpack --config build/webpack.config.js --mode production",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@leetrack/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-prettier": "^5.2.2",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.4.2",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.1.14",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
