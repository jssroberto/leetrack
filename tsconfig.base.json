{
  "compilerOptions": {
    "baseUrl": ".",
    "experimentalDecorators": true,
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@api/*": ["./apps/api/src/*"],
      "@web/*": ["./apps/web/*"],
      "@extension/*": ["./apps/extension/src/*"],
      "@leetrack/shared-types": ["./libs/shared/types/src/index.ts"],
      "@leetrack/database": ["./libs/database/src/index.ts"]
    }
  }
}
